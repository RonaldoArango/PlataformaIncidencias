@{
    ViewData["Title"] = "Inicio";
}

<div class="container mt-5">

    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold">Plataforma de Incidencias</h1>

        <p class="lead text-muted">
            Sistema de gestión y seguimiento de incidencias
        </p>

        <p>
            Consulta, busca y administra las incidencias registradas
            en las estaciones.
        </p>
    </div>

    <div class="row justify-content-center g-4">

        <div class="col-md-5">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center p-4">

                    <h3>Gestión de incidencias</h3>

                    <p class="text-muted">
                        Visualiza las incidencias abiertas,
                        filtra por prioridad y realiza búsquedas.
                    </p>

                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <a asp-controller="Operaciones"
                           asp-action="Incidencias"
                           class="btn btn-primary btn-lg">
                            Ver incidencias
                        </a>
                    }
                    else
                    {
                        <a asp-area="Identity"
                           asp-page="/Account/Login"
                           class="btn btn-primary btn-lg">
                            Iniciar sesión
                        </a>
                    }

                </div>
            </div>
        </div>

        <div class="col-md-5">
            <div class="card shadow-sm h-100">
                <div class="card-body p-4">

                    <h3 class="text-center mb-3">
                        Funcionalidades
                    </h3>

                    <ul class="list-group list-group-flush">
                        <li class="list-group-item">
                            🔎 Búsqueda de incidencias con Algolia
                        </li>

                        <li class="list-group-item">
                            ⚠️ Identificación de incidencias críticas
                        </li>

                        <li class="list-group-item">
                            📋 Filtro por prioridad
                        </li>

                        <li class="list-group-item">
                            ✅ Cierre de incidencias
                        </li>

                        <li class="list-group-item">
                            ⚡ Actualizaciones en tiempo real
                        </li>
                    </ul>

                </div>
            </div>
        </div>

    </div>

</div>