@model IEnumerable<PlataformaIncidencias.Models.Incidencia>

@{
    ViewData["Title"] = "Incidencias";
}

<h1>Incidencias abiertas en tiempo real</h1>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}

<div class="alert alert-danger">
    <strong>Incidencias criticas:</strong> @ViewBag.Criticas
</div>

<div id="estadoWebSocket" class="alert alert-secondary">
    Conectando con PieSocket...
</div>

<form method="get"
      asp-controller="Operaciones"
      asp-action="Incidencias"
      class="mb-4">

    <div class="mb-3">
        <label class="form-label">
            <strong>Buscar incidencia:</strong>
        </label>

        <div class="input-group">
            <input type="text"
                   name="busqueda"
                   value="@ViewBag.Busqueda"
                   class="form-control"
                   placeholder="Buscar por estacion o descripcion..." />

            <button type="submit"
                    class="btn btn-primary">
                Buscar
            </button>

            <a asp-controller="Operaciones"
               asp-action="Incidencias"
               class="btn btn-secondary">
                Limpiar
            </a>
        </div>
    </div>

    <div>
        <label class="form-label">
            <strong>Filtrar por prioridad:</strong>
        </label>

        <select name="prioridad"
                class="form-select"
                style="width:250px;">

            <option value="">Todas</option>
            <option value="Alta">Alta</option>
            <option value="Media">Media</option>
            <option value="Baja">Baja</option>

        </select>

        <button type="submit"
                class="btn btn-primary mt-2">
            Filtrar
        </button>
    </div>

</form>

<table class="table">
    <thead>
        <tr>
            <th>Estacion</th>
            <th>Descripcion</th>
            <th>Prioridad</th>
            <th>Estado</th>
            <th>Accion</th>
        </tr>
    </thead>

    <tbody id="tablaIncidencias">

        @foreach (var incidencia in Model)
        {
            <tr id="incidencia-@incidencia.Id">

                <td>@incidencia.Estacion</td>
                <td>@incidencia.Descripcion</td>
                <td>@incidencia.Prioridad</td>
                <td>@incidencia.Estado</td>

                <td>
                    <form asp-controller="Operaciones"
                          asp-action="Cerrar"
                          method="post">

                        <input type="hidden"
                               name="id"
                               value="@incidencia.Id" />

                        <button type="submit"
                                class="btn btn-danger">
                            Cerrar incidencia
                        </button>

                    </form>
                </td>

            </tr>
        }

    </tbody>
</table>

@if (!Model.Any())
{
    <div class="alert alert-warning">
        No se encontraron incidencias.
    </div>
}

<script>
    const urlPieSocket =
        "wss://free.blr2.piesocket.com/v3/1?api_key=vFD4gReEsOthQgikWfe1zOV3Rn0HN3490lkrqlPe&notify_self=1";

    let socket;
    let primeraConexion = true;

    function conectarPieSocket() {

        console.log("Intentando conectar con PieSocket...");

        socket = new WebSocket(urlPieSocket);

        socket.onopen = function () {

            console.log("PieSocket conectado");

            const estado =
                document.getElementById("estadoWebSocket");

            estado.className = "alert alert-success";

            estado.innerHTML =
                "PieSocket conectado - actualizaciones en tiempo real";

            // Si la conexion se perdio y posteriormente regreso,
            // consultamos nuevamente el estado vigente al servidor.
            if (!primeraConexion) {

                console.log(
                    "Conexion recuperada. Sincronizando estado..."
                );

                window.location.reload();
                return;
            }

            primeraConexion = false;
        };

        socket.onmessage = function (event) {

            console.log(
                "Mensaje recibido desde PieSocket:",
                event.data
            );

            try {

                const mensaje = JSON.parse(event.data);

                let nombreEvento =
                    mensaje.event ??
                    mensaje.eventName ??
                    mensaje.message?.eventName;

                let datos =
                    mensaje.data ??
                    mensaje.message?.data;

                if (typeof datos === "string") {

                    try {
                        datos = JSON.parse(datos);
                    }
                    catch {
                        // Se conserva el valor original
                    }
                }

                if (nombreEvento === "IncidenciaActualizada") {

                    console.log(
                        "IncidenciaActualizada recibida:",
                        datos
                    );

                    if (datos == null)
                        return;

                    const id =
                        datos.Id ?? datos.id;

                    const estado =
                        datos.Estado ?? datos.estado;

                    const fila =
                        document.getElementById(
                            "incidencia-" + id
                        );

                    if (fila && estado === "Cerrada") {

                        fila.remove();

                        console.log(
                            "Incidencia eliminada de la tabla:",
                            id
                        );
                    }
                }
            }
            catch (error) {

                console.log(
                    "Mensaje WebSocket no procesado:",
                    event.data
                );

                console.log(error);
            }
        };

        socket.onclose = function () {

            console.log(
                "Conexion PieSocket cerrada. Reconectando..."
            );

            const estado =
                document.getElementById("estadoWebSocket");

            estado.className = "alert alert-warning";

            estado.innerHTML =
                "Conexion perdida. Reconectando...";

            setTimeout(function () {

                conectarPieSocket();

            }, 3000);
        };

        socket.onerror = function (error) {

            console.log(
                "Error de PieSocket:",
                error
            );
        };
    }

    conectarPieSocket();
</script>