@model IEnumerable<PlataformaIncidencias.Models.Incidencia>

@{
    ViewData["Title"] = "Incidencias";
}

<h1>Incidencias abiertas</h1>

<form method="get" asp-controller="Operaciones" asp-action="Incidencias"
      class="mb-4">

    <div class="input-group">
        <input type="text"
               name="busqueda"
               value="@ViewBag.Busqueda"
               class="form-control"
               placeholder="Buscar por estacion o descripcion..." />

        <button type="submit" class="btn btn-primary">
            Buscar
        </button>

        <a asp-controller="Operaciones"
           asp-action="Incidencias"
           class="btn btn-secondary">
            Limpiar
        </a>
    </div>
</form>

<table class="table">
    <thead>
        <tr>
            <th>Estacion</th>
            <th>Descripcion</th>
            <th>Prioridad</th>
            <th>Estado</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var incidencia in Model)
        {
            <tr>
                <td>@incidencia.Estacion</td>
                <td>@incidencia.Descripcion</td>
                <td>@incidencia.Prioridad</td>
                <td>@incidencia.Estado</td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <div class="alert alert-warning">
        No se encontraron incidencias.
    </div>
}